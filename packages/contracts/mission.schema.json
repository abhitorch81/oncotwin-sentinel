{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oncotwin.dev/contracts/mission.schema.json",
  "title": "OncoTwin Nano Mission",
  "type": "object",
  "required": ["id", "prompt", "state", "events", "receipt"],
  "properties": {
    "id": { "type": "string", "pattern": "^nano-" },
    "prompt": { "type": "string", "minLength": 10 },
    "state": { "enum": ["running", "awaiting_human_approval", "approved", "failed"] },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "receipt": { "$ref": "#/$defs/receipt" },
    "lineage": { "anyOf": [{ "$ref": "#/$defs/missionLineage" }, { "type": "null" }] }
  },
  "$defs": {
    "event": {
      "type": "object",
      "required": ["sequence", "agent", "status", "summary", "artifact", "scene_patch"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "agent": { "enum": ["Evidence Scout", "Nano Designer", "Twin Simulator", "Safety Steward"] },
        "status": { "enum": ["working", "complete", "blocked"] },
        "summary": { "type": "string" },
        "scene_action": { "enum": ["focus_clone", "spawn_candidates", "run_particle_paths", "reject_candidate", "show_approval_membrane"] },
        "artifact": { "$ref": "#/$defs/artifact" },
        "scene_patch": { "$ref": "#/$defs/scenePatch" }
      }
    },
    "metric": {
      "type": "object",
      "required": ["label", "value", "tone"],
      "properties": {
        "label": { "type": "string" },
        "value": { "type": ["string", "number"] },
        "unit": { "type": ["string", "null"] },
        "tone": { "enum": ["neutral", "good", "warning", "critical"] }
      }
    },
    "artifact": {
      "type": "object",
      "required": ["kind", "title", "detail", "metrics", "evidence_ids"],
      "properties": {
        "kind": { "enum": ["evidence_bundle", "candidate_blueprint", "distribution_comparison", "safety_decision", "approval_boundary"] },
        "title": { "type": "string" },
        "detail": { "type": "string" },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "evidence_ids": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scenePatch": {
      "type": "object",
      "required": ["action", "camera_target", "overlay", "candidate_ids", "emphasis"],
      "properties": {
        "action": { "enum": ["focus_clone", "spawn_candidates", "run_particle_paths", "reject_candidate", "show_approval_membrane"] },
        "camera_target": { "enum": ["clone_r7", "candidate_forge", "tumour_core", "liver_sink", "approval_boundary"] },
        "overlay": { "enum": ["clone_signal", "candidate_blueprints", "distribution_paths", "safety_quarantine", "approval_membrane"] },
        "candidate_ids": { "type": "array", "items": { "enum": ["A", "B", "C"] } },
        "simulation_hour": { "type": ["integer", "null"], "minimum": 0, "maximum": 24 },
        "emphasis": { "enum": ["evidence", "design", "delivery", "risk", "authority"] }
      }
    },
    "simulationFrame": {
      "type": "object",
      "required": ["hour", "candidate_id", "tumour_penetration", "tumour_payload_release", "liver_accumulation", "kidney_accumulation"],
      "properties": {
        "hour": { "type": "integer", "minimum": 0, "maximum": 24 },
        "candidate_id": { "enum": ["A", "B", "C"] },
        "tumour_penetration": { "type": "number", "minimum": 0, "maximum": 1 },
        "tumour_payload_release": { "type": "number", "minimum": 0, "maximum": 1 },
        "liver_accumulation": { "type": "number", "minimum": 0, "maximum": 1 },
        "kidney_accumulation": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "contextualExplanation": {
      "type": "object",
      "required": ["kind", "mission_id", "agent", "candidate_id", "decision", "explanation", "spoken_text", "focus_hour", "metrics", "evidence_ids", "scene_patch", "source_receipt_sha256_prefix", "approval_granted"],
      "properties": {
        "kind": { "const": "contextual_explanation" },
        "mission_id": { "type": "string", "pattern": "^nano-" },
        "agent": { "const": "Safety Steward" },
        "candidate_id": { "enum": ["A", "B", "C"] },
        "decision": { "enum": ["preferred", "acceptable", "rejected"] },
        "explanation": { "type": "string" },
        "spoken_text": { "type": "string" },
        "focus_hour": { "type": "integer", "minimum": 0, "maximum": 24 },
        "metrics": { "type": "array", "items": { "$ref": "#/$defs/metric" } },
        "evidence_ids": { "type": "array", "items": { "type": "string" } },
        "scene_patch": { "$ref": "#/$defs/scenePatch" },
        "source_receipt_sha256_prefix": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "approval_granted": { "const": false }
      }
    },
    "boundedRerunPreview": {
      "type": "object",
      "required": ["kind", "parent_mission_id", "preview_id", "persisted", "lineage_status", "candidate_id", "change", "before", "after", "results", "timeline", "summary", "spoken_text", "scene_patch", "source_receipt_sha256_prefix", "preview_sha256", "approval_granted"],
      "properties": {
        "kind": { "const": "bounded_rerun" },
        "parent_mission_id": { "type": "string", "pattern": "^nano-" },
        "preview_id": { "type": "string", "pattern": "^preview-[a-f0-9]{12}$" },
        "persisted": { "const": false },
        "lineage_status": { "const": "preview_only" },
        "candidate_id": { "enum": ["A", "B", "C"] },
        "change": {
          "type": "object",
          "required": ["parameter", "previous_value", "requested_value", "minimum", "maximum", "unit"],
          "properties": {
            "parameter": { "const": "particle_size_nm" },
            "previous_value": { "type": "number" },
            "requested_value": { "type": "number", "minimum": 35, "maximum": 120 },
            "minimum": { "const": 35 },
            "maximum": { "const": 120 },
            "unit": { "const": "nm" }
          }
        },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "results": { "type": "array", "minItems": 3, "maxItems": 3 },
        "timeline": { "type": "array", "minItems": 75, "maxItems": 75, "items": { "$ref": "#/$defs/simulationFrame" } },
        "summary": { "type": "string" },
        "spoken_text": { "type": "string" },
        "scene_patch": { "$ref": "#/$defs/scenePatch" },
        "source_receipt_sha256_prefix": { "type": "string", "pattern": "^[a-f0-9]{12}$" },
        "preview_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "approval_granted": { "const": false }
      }
    },
    "boundedParameterChange": {
      "type": "object",
      "required": ["parameter", "previous_value", "requested_value", "minimum", "maximum", "unit"],
      "properties": {
        "parameter": { "const": "particle_size_nm" },
        "previous_value": { "type": "number" },
        "requested_value": { "type": "number", "minimum": 35, "maximum": 120 },
        "minimum": { "const": 35 },
        "maximum": { "const": 120 },
        "unit": { "const": "nm" }
      }
    },
    "missionLineage": {
      "type": "object",
      "required": ["relation", "parent_mission_id", "root_mission_id", "source_preview_id", "source_preview_sha256", "source_receipt_sha256", "candidate_id", "parameter_changes", "persisted_by", "persisted_channel"],
      "properties": {
        "relation": { "const": "bounded_rerun" },
        "parent_mission_id": { "type": "string", "pattern": "^nano-" },
        "root_mission_id": { "type": "string", "pattern": "^nano-" },
        "source_preview_id": { "type": "string", "pattern": "^preview-[a-f0-9]{12}$" },
        "source_preview_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "source_receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidate_id": { "enum": ["A", "B", "C"] },
        "parameter_changes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/boundedParameterChange" } },
        "persisted_by": { "type": "string", "minLength": 1 },
        "persisted_channel": { "const": "ui" }
      }
    },
    "persistedChildRun": {
      "type": "object",
      "required": ["kind", "persisted", "lineage_status", "parent_mission_id", "child_mission", "approval_granted"],
      "properties": {
        "kind": { "const": "persisted_child_run" },
        "persisted": { "const": true },
        "lineage_status": { "const": "child_receipt" },
        "parent_mission_id": { "type": "string", "pattern": "^nano-" },
        "child_mission": { "$ref": "#" },
        "approval_granted": { "const": false }
      }
    },
    "receipt": {
      "type": "object",
      "required": ["results", "timeline", "receipt_sha256"],
      "properties": {
        "results": { "type": "array" },
        "timeline": { "type": "array", "minItems": 75, "maxItems": 75, "items": { "$ref": "#/$defs/simulationFrame" } },
        "receipt_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
