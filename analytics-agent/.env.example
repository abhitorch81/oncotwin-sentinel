# The official Analytics Agent currently documents an API key for its Google provider.
LLM_PROVIDER=google
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.0-flash
CHART_LLM_MODEL=gemini-1.5-flash
QUALITY_LLM_MODEL=gemini-1.5-flash
DELIGHT_LLM_MODEL=gemini-1.5-flash

DATAHUB_GMS_URL=http://DATAHUB_PRIVATE_IP:8080
DATAHUB_GMS_TOKEN=
ENGINES_CONFIG=/app/config.yaml
SQL_ROW_LIMIT=500
LOG_LEVEL=INFO

