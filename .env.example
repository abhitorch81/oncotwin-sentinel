# Runtime
APP_ENV=development
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# DataHub Core / Quickstart. For DataHub Cloud, DATAHUB_GMS_URL can instead be
# https://<tenant>.acryl.io; the same self-hosted MCP process works with either.
DATAHUB_GMS_URL=http://127.0.0.1:8080
# Prefer a scoped DataHub service-account token for the agent runtime.
DATAHUB_GMS_TOKEN=
# Separate server-only credential for the explicitly approved GraphQL incident
# resolution path. It may reference the same admin token in a hackathon setup,
# but it is never exposed to the browser or the general agent toolset.
DATAHUB_ADMIN_TOKEN=
DATAHUB_MCP_COMMAND=uvx
DATAHUB_MCP_PACKAGE=mcp-server-datahub@latest
TOOLS_IS_MUTATION_ENABLED=true

# Google Gemini. On Cloud Run, prefer Vertex AI + service-account ADC.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-2.5-flash

# Optional Gemini Developer API fallback
GOOGLE_API_KEY=

# Demo governance
WRITEBACK_APPROVAL_SECRET=replace-with-a-long-random-value
MISSION_STORE_PATH=/tmp/oncotwin-missions

# Official DataHub Analytics Agent URL
ANALYTICS_AGENT_URL=http://localhost:8100
