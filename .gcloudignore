# Upload only the two current applications and their GCP build definitions.
**
!apps/
!apps/**
!infra/
!infra/**
!.dockerignore
!.gcloudignore

# Generated or local-only content inside the allowlisted directories.
apps/web/node_modules/
apps/web/dist/
apps/web/tsconfig.tsbuildinfo
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.DS_Store
**/.env
**/.env.*
!**/.env.example
